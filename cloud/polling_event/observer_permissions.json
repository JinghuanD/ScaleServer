{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObserveExperiment",
      "Effect": "Allow",
      "Action": ["autoscaling:DescribeAutoScalingGroups", "elasticloadbalancing:DescribeTargetHealth"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "lambda:GetFunctionConfiguration",
      "Resource": "arn:aws:lambda:us-east-2:000000000000:function:scaleserver-event-controller"
    },
    {
      "Effect": "Allow",
      "Action": "events:DescribeRule",
      "Resource": ["arn:aws:events:us-east-2:000000000000:rule/scaleserver-alarm-events", "arn:aws:events:us-east-2:000000000000:rule/scaleserver-polling-tick"]
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-2:000000000000:table/scaleserver-controller-state"
    }
  ]
}
